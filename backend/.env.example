# Local only — Supabase/BullMQ/Vercel SKIP
PORT=4000
TIMEZONE=Asia/Karachi

# Facebook Graph API v20.0 (Business Method)
# Jab tak real token nahi hai, app MOCK mode me chalegi.
FB_API_VERSION=v26.0
FB_APP_ID=
FB_BUSINESS_ID=
FB_SYSTEM_USER_TOKEN=
# Frontend ko token KABHI mat bhejo — sirf backend .env me rakho.

FRONTEND_URL=http://localhost:3000

# Auth (multi-user) — PROD me zaroor badlo:
# SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-prod-min-32-chars
# TOKEN_KEY: 64 hex chars (FB token vault encryption). Khali ho to SESSION_SECRET se derived.
TOKEN_KEY=
# Google login (optional): console.cloud.google.com > Credentials > OAuth Client ID (Web)
# Authorized origin me http://localhost:3000 add karo.
GOOGLE_CLIENT_ID=
